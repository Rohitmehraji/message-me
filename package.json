{
  "name": "message-me",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "doctor": "node scripts/doctor.mjs",
    "reset:deps": "node scripts/reset-deps.mjs",
    "reinstall": "npm run reset:deps && npm install",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run start",
    "build": "npm run -ws build",
    "lint": "npm run -ws lint"
  },
  "engines": {
    "node": "18.x || 20.x"
  },
  "overrides": {
    "metro": "0.80.12",
    "metro-config": "0.80.12",
    "metro-core": "0.80.12",
    "metro-resolver": "0.80.12",
    "metro-runtime": "0.80.12"
  }
}
